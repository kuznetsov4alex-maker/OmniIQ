# OmniIQ API — local development environment
# Copy from .env.example and fill in real values

# ── Database ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omniiq

# ── Redis ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Supabase Auth ─────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
# For local dev without auth: leave these as placeholders
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
JWT_SECRET=dev-secret-change-in-production

# ── OpenAI ────────────────────────────────
# Get from: https://platform.openai.com/api-keys
# Leave as sk-test-... to use fallback (no real API calls)
OPENAI_API_KEY=sk-test-placeholder
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ── App ───────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=dev-secret-change-in-production
CORS_ORIGINS=http://localhost:3000
