# OmniIQ — Production .env template
# Copy to .env.prod and fill in ALL values before deploying

# ── Server ────────────────────────────────────────────────────
DOMAIN=omniiq.tech
ADMIN_EMAIL=hello@omniiq.tech

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=omniiq
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ── Supabase Auth ─────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_KEY
JWT_SECRET=CHANGE_ME_64_CHARS_RANDOM_STRING

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ── App ───────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_SECRET
CORS_ORIGINS=["https://omniiq.tech","https://www.omniiq.tech"]
